library(tidyverse)

library(readr)
se_queens_results <- read_csv("se_queens_results.csv")
View(se_queens_results)

# Use read_delim to specify comma separation and handle text quotes
df <- read_delim("se_queens_results.csv", 
                 delim = ",", 
                 escape_double = FALSE, 
                 trim_ws = TRUE)

df$GEOID <- as.character(df$GEOID)

# Verify column names
colnames(df)

# Clean up the dataframe by selecting variables needed for analysis
df_clean <- df %>%
  select(
    GEOID = GEOID, 
    Slope_Mean = slp_mean, 
    Scenario_B_Equity = ScenB_mean, 
    BGI_Typology = BGI_Type
  )

head(df_clean)

# Convert to a factor matching exact symbology categories
df_clean$BGI_Typology <- factor(df_clean$BGI_Typology, 
                                levels = c("Cloudburst Road", "Blue-Green Street", "Retention Street"))

# Summary table
typology_summary <- df_clean %>%
  group_by(BGI_Typology) %>%
  summarise(
    Tract_Count = n(),
    Percentage = (n() / nrow(df_clean)) * 100
  )

print(typology_summary)

# Test a calibrated threshold of 0.20 for Scenario B using lowercase case_when
df_clean <- df_clean %>%
  mutate(BGI_Calibrated = case_when(
    Slope_Mean >= 0.03 ~ "Cloudburst Road",
    Scenario_B_Equity >= 0.20 ~ "Blue-Green Street",
    TRUE ~ "Retention Street"
  ))

# Convert the new column to a factor so it summarizes cleanly
df_clean$BGI_Calibrated <- factor(df_clean$BGI_Calibrated, 
                                  levels = c("Cloudburst Road", "Blue-Green Street", "Retention Street"))

# Calculate and print the new distribution
calibrated_summary <- df_clean %>%
  group_by(BGI_Calibrated) %>%
  summarise(
    Tract_Count = n(),
    Percentage = (n() / nrow(df_clean)) * 100
  )

print(calibrated_summary)

# View and sort the 13 tracts that qualify under the 0.20 equity tier
equity_hotspots <- df_clean %>%
  filter(Scenario_B_Equity >= 0.20) %>%
  arrange(desc(Scenario_B_Equity)) %>%
  select(GEOID, Slope_Mean, Scenario_B_Equity, BGI_Typology, BGI_Calibrated)

print(equity_hotspots)

# Create a boxplot visualizing the sensitivity shift
ggplot(df_clean, aes(x = BGI_Calibrated, y = Scenario_B_Equity, fill = BGI_Calibrated)) +
  geom_boxplot(alpha = 0.8, outlier.shape = 16, outlier.size = 2) +
  scale_fill_manual(values = c("Cloudburst Road" = "#4682B4",       # Blue
                               "Blue-Green Street" = "#2E8B57",     # Green
                               "Retention Street" = "#ED7D31")) +   # Orange
  labs(
    title = "Figure 1. Sensitivity Analysis of Scenario B Equity Distribution across Calibrated BGI Typologies",
    subtitle = "Calibrated Threshold (Scenario B >= 0.20)",
    x = "Calibrated BGI Typology",
    y = "Mean Scenario B Equity Score (Normalized)",
    caption = "Source: Spatial Decision Support System (SDSS) Cloudburst Framework"
  ) +
  theme_classic() +
  theme(
    plot.title = element_text(face = "bold", size = 11),
    plot.subtitle = element_text(face = "italic", size = 9),
    legend.position = "none",
    axis.title = element_text(size = 10)
  )

# Check for significant differences across categories
k_test <- kruskal.test(Scenario_B_Equity ~ BGI_Calibrated, data = df_clean)

# Print results
print("Kruskal-Wallis Rank Sum Test:")
print(k_test)

library(spdep)

# Pull the X and Y coordinates directly from loaded 'df' object
coords <- cbind(df$X, df$Y)

# Build the distance-based neighbor network
neighbors <- dnearneigh(coords, 0, 1500)

# Create spatial weights with zero.policy active for edges
weights <- nb2listw(neighbors, style = "W", zero.policy = TRUE)

# Run the spatial clustering test on Scenario B Equity metrics
moran_result <- moran.test(df_clean$Scenario_B_Equity, weights, zero.policy = TRUE)

print(moran_result)

sessionInfo()
